{
	"name": "@westtrade/fch",
	"version": "1.15.1",
	"description": "URL and fetch combined: a request builder that IS a URL — with retries, timeouts, dedupe and typed body helpers.",
	"main": "dist/Fch.js",
	"types": "dist/Fch.d.ts",
	"exports": {
		".": {
			"types": "./dist/Fch.d.ts",
			"import": "./dist/Fch.mjs",
			"require": "./dist/Fch.js",
			"default": "./dist/Fch.js"
		},
		"./literal": {
			"types": "./dist/Fch.literal.d.ts",
			"import": "./dist/Fch.literal.mjs",
			"require": "./dist/Fch.literal.js",
			"default": "./dist/Fch.literal.js"
		},
		"./package.json": "./package.json",
		"./plugins/nanostores": {
			"types": "./dist/plugins/nanostores.d.ts",
			"import": "./dist/plugins/nanostores.mjs",
			"require": "./dist/plugins/nanostores.js",
			"default": "./dist/plugins/nanostores.js"
		},
		"./plugins/validate": {
			"types": "./dist/plugins/validate.d.ts",
			"import": "./dist/plugins/validate.mjs",
			"require": "./dist/plugins/validate.js",
			"default": "./dist/plugins/validate.js"
		},
		"./plugins/compat": {
			"types": "./dist/plugins/compat.d.ts",
			"import": "./dist/plugins/compat.mjs",
			"require": "./dist/plugins/compat.js",
			"default": "./dist/plugins/compat.js"
		},
		"./plugins/logger": {
			"types": "./dist/plugins/logger.d.ts",
			"import": "./dist/plugins/logger.mjs",
			"require": "./dist/plugins/logger.js",
			"default": "./dist/plugins/logger.js"
		}
	},
	"scripts": {
		"build": "tsc && node scripts/build-esm.mjs",
		"test": "vitest run",
		"size": "size-limit",
		"site": "npm run build && node scripts/build-demo-bundle.mjs && node scripts/build-site.mjs && node scripts/build-site-css.mjs",
		"site:serve": "python3 -m http.server 8765 --directory site",
		"site:check": "node scripts/check-all.mjs && node scripts/check-visual.mjs && node scripts/check-interactions.mjs && node scripts/check-file-protocol.mjs && node scripts/check-star-cta.mjs",
		"prepublishOnly": "npm run build",
		"prepare": "npm run build",
		"site:check:subpath": "node scripts/check-subpath.mjs",
		"site:check:live": "node scripts/check-live.mjs"
	},
	"keywords": [
		"fetch",
		"url",
		"request",
		"retry",
		"timeout",
		"http",
		"urlsearchparams",
		"typescript"
	],
	"author": "westtrade",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/westtrade/Fch.git"
	},
	"devDependencies": {
		"@mswjs/interceptors": "^0.37.6",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@size-limit/file": "^14.2.0",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/oxide": "^4.3.3",
		"esbuild": "^0.24.2",
		"gpt-tokenizer": "^2.9.0",
		"highlight.js": "^11.12.0",
		"jsdom": "^30.1.1",
		"marked": "^15.0.12",
		"msw": "^2.7.0",
		"semantic-release": "^25.0.9",
		"size-limit": "^14.2.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.0.0",
		"vitest": "^3.0.5"
	},
	"size-limit": [
		{
			"path": "dist/Fch.js",
			"limit": "8 kB"
		}
	],
	"files": [
		"dist"
	]
}
